---
import Base from '../../layouts/Base.astro';
import { getBlogPosts, formatDate, getAssetUrl, resolveAsset } from '../../lib/contentful';

const limit = 9;

// Fetch all posts — pagination is handled client-side for static hosting
let postsResponse: any = { items: [], total: 0, includes: {} };
try {
  postsResponse = await getBlogPosts({ limit: 1000 });
} catch (e) {
  console.error('Error fetching blog posts:', e);
}

const items: any[] = Array.isArray(postsResponse.items) ? postsResponse.items : [];
const includes: any = postsResponse?.includes ?? {};

const allPosts = items
  .filter((it) => it?.sys?.type === 'Entry' && it?.fields && it.fields.title && it.fields.slug)
  .map((it) => ({
    ...it,
    featuredResolved: resolveAsset(it.fields.featuredImage, includes)
  }));

const totalPosts = allPosts.length;
const totalPages = Math.max(1, Math.ceil(totalPosts / limit));

const tagSet = new Set<string>();
allPosts.forEach((p: any) => (p?.fields?.tags ?? []).forEach((t: string) => tagSet.add(t)));
const allTags = Array.from(tagSet).sort();
---

<Base
  title="Blog - How God Speaks To Us"
  description="Sermon notes, reflections, and meditations on God's Word."
  canonical={`${Astro.url.origin}/blog`}
>
  <!-- Header -->
  <section class="relative bg-black text-white pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Our Blog</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          Sermon notes, reflections, and meditations on God's Word.
        </p>
      </div>

      <!-- Tag Filtering -->
      {allTags.length > 0 && (
        <div class="mt-12">
          <div
            class="flex flex-wrap justify-center gap-2"
            id="tag-filter-container"
            role="group"
            aria-label="Filter posts by tag"
          >
            <button
              type="button"
              class="px-4 py-2 rounded-full text-sm font-medium transition-colors bg-white text-black border-2 border-white"
              data-tag="all"
              id="tag-all"
              aria-pressed="true"
            >
              All Posts
            </button>
            {allTags.map((tagName) => (
              <button
                type="button"
                class="px-4 py-2 rounded-full text-sm font-medium transition-colors bg-transparent text-gray-300 border border-gray-600 hover:border-white hover:text-white"
                data-tag={tagName}
                id={`tag-${tagName}`}
                aria-pressed="false"
              >
                {tagName}
              </button>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Blog Posts Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {allPosts.length > 0 ? (
        <>
          <!-- Results count -->
          <div class="mb-8">
            <p class="text-gray-700" id="results-count">
              Showing all posts ({totalPosts} total)
            </p>
          </div>

          <!-- Posts Grid -->
          <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
            id="posts-grid"
            data-total-items={totalPosts}
            data-total-pages={totalPages}
          >
            {allPosts.map((post, index) => {
              const postPage = Math.floor(index / limit) + 1;
              const isVisible = postPage === 1;

              return (
                <article
                  class="bg-white border border-gray-200 overflow-hidden hover:border-black hover:shadow-lg transition-all duration-300 post-item"
                  data-tags={post?.fields?.tags?.join(',') || ''}
                  style={isVisible ? '' : 'display: none;'}
                >
                  {post.featuredResolved && (
                    <div class="w-full aspect-[3/2] overflow-hidden">
                      <img
                        src={getAssetUrl(post.featuredResolved, 800, 533)}
                        alt={post.featuredResolved?.fields?.title ?? post.fields.title}
                        class="w-full h-full object-cover object-center grayscale hover:grayscale-0 transition-all"
                        loading="lazy"
                        decoding="async"
                        width="800"
                        height="533"
                        fetchpriority="low"
                      />
                    </div>
                  )}
                  <div class="p-6">
                    <div class="flex items-center text-sm text-gray-600 mb-3">
                      <time datetime={post?.fields?.publishDate}>
                        {formatDate(post?.fields?.publishDate ?? new Date().toISOString())}
                      </time>
                      {post?.fields?.author && (
                        <>
                          <span class="mx-2">•</span>
                          <span>{post.fields.author}</span>
                        </>
                      )}
                    </div>
                    <h2 class="text-xl font-bold text-black mb-3">
                      <a href={`/blog/${post?.fields?.slug}`} class="hover:underline transition-colors">
                        {post?.fields?.title ?? '(Untitled)'}
                      </a>
                    </h2>
                    {post?.fields?.excerpt && (
                      <p class="text-gray-700 mb-4 line-clamp-3">
                        {post.fields.excerpt}
                      </p>
                    )}
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                      <a
                        href={`/blog/${post?.fields?.slug}`}
                        class="text-black hover:underline font-semibold transition-colors self-start border-b-2 border-black pb-1"
                      >
                        Read more →
                      </a>
                      {!!(post?.fields?.tags?.length) && (
                        <div class="flex flex-wrap gap-2">
                          {post.fields.tags.slice(0, 2).map((tagName: string) => (
                            <span class="text-xs bg-gray-100 text-black px-3 py-1 border border-gray-300 whitespace-nowrap">
                              {tagName}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- Pagination -->
          {totalPages > 1 && (
            <div class="mt-16 flex justify-center">
              <nav class="flex items-center space-x-2" id="pagination-nav" aria-label="Pagination">
                <button
                  type="button"
                  id="prev-btn"
                  class="px-3 py-2 text-sm font-medium text-black bg-white border-2 border-black hover:bg-black hover:text-white transition-colors"
                  style="display: none;"
                >
                  Previous
                </button>

                {Array.from({ length: totalPages }, (_, i) => i + 1).map((pageNum) => (
                  <button
                    type="button"
                    class={`px-3 py-2 text-sm font-medium transition-colors pagination-btn ${
                      pageNum === 1
                        ? 'bg-black text-white border-2 border-black'
                        : 'text-black bg-white border-2 border-gray-300 hover:border-black'
                    }`}
                    data-page={pageNum}
                    aria-current={pageNum === 1 ? 'page' : undefined}
                  >
                    {pageNum}
                  </button>
                ))}

                <button
                  type="button"
                  id="next-btn"
                  class="px-3 py-2 text-sm font-medium text-black bg-white border-2 border-black hover:bg-black hover:text-white transition-colors"
                >
                  Next
                </button>
              </nav>
            </div>
          )}
        </>
      ) : (
        <div class="text-center py-16">
          <div class="mx-auto w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mb-6">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
          </div>
          <h3 class="text-lg font-medium text-black mb-2">No posts found</h3>
          <p class="text-gray-700 mb-6">
            No blog posts available at the moment.
          </p>
        </div>
      )}
    </div>
  </section>
</Base>

<script type="application/json" id="list-pagination-config">
  {
    "itemSelector": ".post-item",
    "limit": 9,
    "gridId": "posts-grid",
    "resultsAll": "Showing all posts",
    "resultsTagged": "Showing posts tagged with"
  }
</script>
<script src="/js/list-pagination.js" defer></script>
