---
import Base from '../../layouts/Base.astro';
import { getDailyVerses, formatDate } from '../../lib/contentful';
import { renderRichText } from '../../lib/rich-text-renderer';

const limit = 12;

// Fetch all verses — pagination and tag filtering handled client-side for static hosting
let allVersesResponse = { items: [], total: 0, includes: {} };
try {
  allVersesResponse = await getDailyVerses({ limit: 1000 });
} catch (e) {
  console.error('Error fetching daily verses:', e);
}

const allItems = Array.isArray(allVersesResponse.items) ? allVersesResponse.items : [];

const today = new Date();
today.setHours(0, 0, 0, 0);
const todayString = today.toISOString().split('T')[0];

const allValidVerses = allItems
  .filter((it) => {
    if (!it || it.sys?.type !== 'Entry' || !it.fields) return false;
    return !!(it.fields.date && it.fields.verse);
  })
  .map((it) => {
    const dateString = it.fields.date ? new Date(it.fields.date).toISOString().split('T')[0] : null;
    return {
      ...it,
      dateString
    };
  })
  .filter((it) => {
    if (!it.dateString) return false;
    return it.dateString <= todayString;
  });

const tagCounts = new Map<string, number>();
allValidVerses.forEach((verse) => {
  const tags = verse?.fields?.tag || [];
  if (Array.isArray(tags)) {
    tags.forEach((tag: string) => {
      tagCounts.set(tag, (tagCounts.get(tag) || 0) + 1);
    });
  }
});

const TAG_VISIBLE_LIMIT = 10;
const sortedTagsByCount = Array.from(tagCounts.entries()).sort(
  (a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
const topTags = sortedTagsByCount.slice(0, TAG_VISIBLE_LIMIT).map(([tag]) => tag);
const topTagSet = new Set(topTags);
const allTags = Array.from(tagCounts.keys()).sort();
const collapsedTags = allTags.filter((tag) => !topTagSet.has(tag));
const hasCollapsedTags = collapsedTags.length > 0;

const totalVerses = allValidVerses.length;
const totalPages = Math.max(1, Math.ceil(totalVerses / limit));
---

<Base
  title="Daily Verses - How God Speaks To Us"
  description="A collection of daily verses and meditations on God's Word."
  canonical={`${Astro.url.origin}/daily-verses`}
>
  <!-- Header -->
  <section class="relative bg-black text-white pt-32 pb-16 md:pt-40 md:pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">Daily Verses</h1>
        <p class="text-xl text-gray-400 max-w-2xl mx-auto">
          A collection of daily verses and meditations on God's Word.
        </p>
      </div>

      <!-- Tag Filtering -->
      {allTags.length > 0 && (
        <div class="mt-12">
          <div
            class="flex flex-wrap justify-center gap-2"
            id="tag-filter-container"
            role="group"
            aria-label="Filter verses by tag"
          >
            <button
              type="button"
              class="px-4 py-2 rounded-full text-sm font-medium transition-colors bg-white text-black border-2 border-white"
              data-tag="all"
              id="tag-all"
              aria-pressed="true"
            >
              All Verses
            </button>
            {topTags.map((tagName) => (
              <button
                type="button"
                class="px-4 py-2 rounded-full text-sm font-medium transition-colors bg-transparent text-gray-300 border border-gray-600 hover:border-white hover:text-white"
                data-tag={tagName}
                id={`tag-${tagName}`}
                aria-pressed="false"
              >
                {tagName}
              </button>
            ))}
            {collapsedTags.map((tagName) => (
              <button
                type="button"
                class="tag-filter-extra hidden px-4 py-2 rounded-full text-sm font-medium transition-colors bg-transparent text-gray-300 border border-gray-600 hover:border-white hover:text-white"
                data-tag={tagName}
                id={`tag-${tagName}`}
                aria-pressed="false"
              >
                {tagName}
              </button>
            ))}
            {hasCollapsedTags && (
              <button
                type="button"
                id="tag-show-all-btn"
                class="px-4 py-2 rounded-full text-sm font-medium transition-colors bg-transparent text-white border border-dashed border-gray-500 hover:border-white hover:text-white"
                aria-expanded="false"
              >
                Show all categories
              </button>
            )}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Verses Grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {allValidVerses.length > 0 ? (
        <>
          <!-- Results count -->
          <div class="mb-8">
            <p class="text-gray-700" id="results-count">
              Showing all verses ({totalVerses} total)
            </p>
          </div>

          <!-- Verses Grid -->
          <div 
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" 
            id="verses-grid"
            data-total-items={totalVerses}
            data-total-pages={totalPages}
          >
            {allValidVerses.map((verse, index) => {
              // Render verse preview (first paragraph or truncated)
              let versePreview = '';
              try {
                if (verse?.fields?.verse) {
                  const rendered = renderRichText(verse.fields.verse);
                  
                  // More robust extraction: try multiple approaches
                  let text = '';
                  
                  // First, try to match paragraph with nested tags (using a more robust regex)
                  // This regex handles nested tags by matching the first <p> to its closing </p>
                  const paragraphMatch = rendered.match(/<p[^>]*>([\s\S]*?)<\/p>/);
                  if (paragraphMatch && paragraphMatch[1]) {
                    text = paragraphMatch[1];
                  } else {
                    // Fallback: strip all HTML tags and get first meaningful text
                    text = rendered.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
                  }
                  
                  if (text) {
                    // Remove any remaining HTML tags and decode HTML entities
                    text = text.replace(/<[^>]*>/g, '');
                    // Decode HTML entities (more comprehensive list)
                    text = text
                      .replace(/&quot;/g, '"')
                      .replace(/&amp;/g, '&')
                      .replace(/&lt;/g, '<')
                      .replace(/&gt;/g, '>')
                      .replace(/&#039;/g, "'")
                      .replace(/&apos;/g, "'")
                      .replace(/&nbsp;/g, ' ')
                      .replace(/&#8217;/g, "'")
                      .replace(/&#8220;/g, '"')
                      .replace(/&#8221;/g, '"')
                      .replace(/&#8211;/g, '–')
                      .replace(/&#8212;/g, '—');
                    
                    // Clean up extra whitespace
                    text = text.replace(/\s+/g, ' ').trim();
                    
                    if (text) {
                      versePreview = text.substring(0, 150);
                      if (text.length >= 150) versePreview += '...';
                    }
                  }
                }
              } catch (e) {
                console.error('Error rendering verse preview:', e, verse?.fields?.passage);
              }

              // Determine which page this verse belongs to
              const versePage = Math.floor(index / limit) + 1;
              const isVisible = versePage === 1; // Show first page by default
              
              const verseTags = verse?.fields?.tag || [];
              const tagsString = Array.isArray(verseTags) ? verseTags.join(',') : '';
              
              return (
                <article 
                  class="bg-white border border-gray-200 overflow-hidden hover:border-black hover:shadow-lg transition-all duration-300 verse-item"
                  data-page={versePage}
                  data-tags={tagsString}
                  style={isVisible ? '' : 'display: none;'}
                >
                  <div class="p-6">
                    <div class="flex items-center text-sm text-gray-600 mb-3">
                      <time datetime={verse?.fields?.date}>
                        {formatDate(verse?.fields?.date ?? new Date().toISOString())}
                      </time>
                    </div>
                    {verse?.fields?.passage && (
                      <h3 class="text-lg font-bold text-black mb-3">
                        {verse.fields.passage}
                      </h3>
                    )}
                    <div class="mb-4">
                      {versePreview ? (
                        <p class="text-gray-800 text-lg leading-relaxed italic mb-2">
                          "{versePreview}"
                        </p>
                      ) : (
                        <p class="text-gray-500 italic">Verse content available</p>
                      )}
                    </div>
                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-3">
                      <a
                        href={`/daily-verses/${verse.dateString}`}
                        class="text-black hover:underline font-semibold transition-colors self-start border-b-2 border-black pb-1"
                      >
                        Read verse →
                      </a>
                      {Array.isArray(verseTags) && verseTags.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                          {verseTags.slice(0, 2).map((tagName: string) => (
                            <span class="text-xs bg-gray-100 text-black px-3 py-1 border border-gray-300 whitespace-nowrap">
                              {tagName}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </article>
              );
            })}
          </div>

          <!-- Pagination -->
          {totalPages > 1 && (
            <div class="mt-16 flex justify-center px-4">
              <nav class="flex flex-wrap items-center justify-center gap-2" id="pagination-nav" aria-label="Pagination">
                <button
                  type="button"
                  id="first-btn"
                  class="px-3 py-2 text-sm font-medium text-black bg-white border-2 border-black hover:bg-black hover:text-white transition-colors disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white disabled:hover:text-black"
                  disabled
                >
                  First
                </button>
                <button
                  type="button"
                  id="prev-btn"
                  class="px-3 py-2 text-sm font-medium text-black bg-white border-2 border-black hover:bg-black hover:text-white transition-colors disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white disabled:hover:text-black"
                  disabled
                >
                  Previous
                </button>
                <span
                  id="page-indicator"
                  class="px-3 py-2 text-sm font-medium text-black min-w-[6.5rem] text-center"
                  aria-live="polite"
                >
                  Page 1 of {totalPages}
                </span>
                <button
                  type="button"
                  id="next-btn"
                  class="px-3 py-2 text-sm font-medium text-black bg-white border-2 border-black hover:bg-black hover:text-white transition-colors disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white disabled:hover:text-black"
                >
                  Next
                </button>
                <button
                  type="button"
                  id="last-btn"
                  class="px-3 py-2 text-sm font-medium text-black bg-white border-2 border-black hover:bg-black hover:text-white transition-colors disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-white disabled:hover:text-black"
                >
                  Last
                </button>
              </nav>
            </div>
          )}
        </>
      ) : (
        <div class="text-center py-16">
          <div class="mx-auto w-24 h-24 bg-gray-200 rounded-full flex items-center justify-center mb-6">
            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-lg font-medium text-black mb-2">No verses found</h3>
          <p class="text-gray-700 mb-6">
            No daily verses available at the moment.
          </p>
        </div>
      )}
    </div>
  </section>
</Base>

<script type="application/json" id="list-pagination-config">
  {
    "itemSelector": ".verse-item",
    "limit": 12,
    "gridId": "verses-grid",
    "resultsAll": "Showing all verses",
    "resultsTagged": "Showing verses tagged with",
    "compactPagination": true,
    "tagCollapse": true
  }
</script>
<script src="/js/list-pagination.js" defer></script>

